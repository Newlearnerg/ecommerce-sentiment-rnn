# Handle line endings automatically
* text=auto 

# CSV data files - preserve UTF-8 encoding, use LF line endings
*.csv text eol=lf 

# Python source files
*.py text eol=lf

# Markdown and text
*.txt text eol=lf
*.md  text eol=lf

# Jupyter notebooks
*.ipynb text eol=lf

# Binary files - do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pkl binary
*.bin binary
*.pt binary
*.h5 binary
*.model binary

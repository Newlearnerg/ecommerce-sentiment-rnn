# Handle line endings automatically
* text=auto eol=lf

# CSV data files - preserve UTF-8 encoding, use LF line endings
*.csv text eol=lf working-tree-encoding=UTF-8

# Python source files
*.py text eol=lf

# Markdown and text
*.md text eol=lf
*.txt text eol=lf

# Jupyter notebooks
*.ipynb text eol=lf

# Binary files - do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pkl binary
*.bin binary
*.pt binary
*.h5 binary
*.model binary
# Handle line endings automatically
* text=auto eol=lf

# CSV data files - preserve UTF-8 encoding, use LF line endings
*.csv text working-tree-encoding=UTF-8

# Python source files
*.py text working-tree-encoding=UTF-8

# Markdown and text
*.md  text working-tree-encoding=UTF-8
*.txt text working-tree-encoding=UTF-8

# Jupyter notebooks
*.ipynb text working-tree-encoding=UTF-8

# Binary files - do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pkl binary
*.bin binary
*.pt binary
*.h5 binary
*.model binary
